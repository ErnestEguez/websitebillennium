{
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- .",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, X-Supabase-Token, apikey" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/google:path*.html",
      "destination": "/google:path*.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/blog",
      "destination": "https://blog-billennium2026.vercel.app/"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog-billennium2026.vercel.app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://blog-billennium2026.vercel.app/_next/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
