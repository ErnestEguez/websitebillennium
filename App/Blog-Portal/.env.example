# ── Sanity (público, va en el bundle del cliente para el Studio) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# ── Sanity (privado, SOLO servidor — nunca con prefijo NEXT_PUBLIC_) ──
# Token con permiso de escritura (Sanity → manage.sanity.io → API → Tokens → "Editor").
# Se usa para: el script de migración (npm run migrate:posts).
SANITY_API_READ_TOKEN=

# Secreto compartido con el webhook de Sanity (Settings → API → Webhooks).
# Se usa para validar la firma HMAC en app/api/revalidate/route.ts.
SANITY_REVALIDATE_SECRET=
